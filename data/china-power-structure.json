  "tour": [
    {
      "id": "intro",
      "title": "Two hierarchies, not one",
      "body": "China runs on two parallel ladders: the formal <strong>state</strong> on the left, and the <strong>Communist Party</strong> on the right. Everything that follows is about how they connect."
    },
    {
      "id": "ladders",
      "title": "Two ladders to the top",
      "body": "Each side climbs from a mass <strong>congress</strong> up through a committee to a small leadership core — a <strong>President</strong> and <strong>Premier</strong> on the state side, the <strong>Standing Committee</strong> and <strong>General Secretary</strong> on the Party side.",
      "focus": ["n-npc", "n-npcsc", "n-president", "n-premier", "n-statecouncil", "n-npcongress", "n-cc", "n-politburo", "n-psc", "n-gensec"]
    },
    {
      "id": "approve",
      "title": "The Party chooses who governs",
      "body": "The hinge of the system: the Party doesn't run the state directly — it decides <em>who</em> does. The Standing Committee <strong>nominates</strong>; the congresses <strong>approve</strong>. The vote ratifies a choice already made.",
      "focus": ["n-psc", "n-president", "n-premier"],
      "edge_types": ["nominate", "approve"]
    },
    {
      "id": "same",
      "title": "Often, the same person",
      "body": "And the same individuals wear both hats. Xi Jinping is at once <strong>General Secretary</strong>, <strong>President</strong>, and <strong>Chairman of the Central Military Commission</strong> — one body in identical Party and state versions.",
      "focus": ["n-gensec", "n-president", "n-cmc-ccp", "n-cmc-prc"],
      "edge_types": ["same"]
    },
    {
      "id": "fractal",
      "title": "It repeats all the way down",
      "body": "This isn't only national. The same paired structure reproduces at the provincial, prefectural, county and township levels — and at every rung, the local <strong>Party Secretary</strong> outranks the government leader.",
      "scope": "full"
    }
  ]
}
